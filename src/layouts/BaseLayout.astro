---
import {
  SUPPORTED_LANGUAGES,
  TRANSLATIONS,
  getCanonicalUrl,
  type LocaleCode,
} from '../i18n/translations';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: LocaleCode;
  pagePath: '' | 'how-to-use/' | 'hire-me/';
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
}

const { locale, pagePath, title, description, schemas = [] } = Astro.props;
const canonicalUrl = getCanonicalUrl(locale, pagePath);
const xDefaultUrl = getCanonicalUrl('en', pagePath);
const currentLang = SUPPORTED_LANGUAGES.find((l) => l.code === locale) ?? SUPPORTED_LANGUAGES[0];
const alternateLocales = SUPPORTED_LANGUAGES.filter((l) => l.code !== locale);
const ogImageUrl = 'https://modelixai.github.io/og-image.png';
const t = TRANSLATIONS[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var isDark = saved
            ? saved === 'dark'
            : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      })();
    </script>
    <!-- Analytics placeholder: add GTM/GA4 snippet here in the future -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#4A6FA5" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="canonical" href={canonicalUrl} />
    {
      SUPPORTED_LANGUAGES.map((lang) => (
        <link rel="alternate" hreflang={lang.code} href={getCanonicalUrl(lang.code, pagePath)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ModelixAI" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={currentLang.ogLocale} />
    {
      alternateLocales.map((alt) => (
        <meta property="og:locale:alternate" content={alt.ogLocale} />
      ))
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ModelixAI — Interactive 3D Model Viewer & GLB/STL Inspector" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <slot name="head" />
  </head>
  <body class="bg-page text-txt-primary font-sans antialiased selection:bg-accent selection:text-accent-contrast">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 focus:rounded-lg focus:bg-accent focus:text-accent-contrast focus:font-semibold focus:shadow-lg"
    >
      {t.nav.home}
    </a>

    <Navbar locale={locale} pagePath={pagePath} />

    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>

    <Footer locale={locale} pagePath={pagePath} />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
