---
import HireMePage from '../../components/pages/HireMePage.astro';
import { NON_DEFAULT_LOCALES, type LocaleCode } from '../../i18n/translations';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: LocaleCode };
---

<HireMePage locale={lang} />
