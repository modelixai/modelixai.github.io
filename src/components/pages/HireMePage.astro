---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { TRANSLATIONS, getCanonicalUrl, type LocaleCode } from '../../i18n/translations';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale];
const homeUrl = getCanonicalUrl(locale, '');
const pageUrl = getCanonicalUrl(locale, 'hire-me/');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.nav.home,
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.hireMe,
      item: pageUrl,
    },
  ],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kishara Dilshan',
  url: pageUrl,
  email: 'mailto:kisharadilshan007@gmail.com',
  jobTitle: 'Full-Stack & Client-Side 3D Web Developer',
  knowsAbout: [
    'Astro',
    'React',
    'Next.js',
    'Three.js',
    'WebGL',
    'WebAssembly',
    'Technical SEO',
    'UI/UX Design',
  ],
  sameAs: [
    'https://github.com/modelixai/modelixai.github.io',
    'https://kisharadilshan.gumroad.com/coffee',
  ],
};
---

<BaseLayout
  locale={locale}
  pagePath="hire-me/"
  title={t.hireMe.title}
  description={t.hireMe.metaDescription}
  schemas={[breadcrumbSchema, personSchema]}
>
  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs locale={locale} currentLabel={t.nav.hireMe} />

    <div class="rounded-2xl border border-line bg-card p-6 shadow-sm sm:p-10">
      <h1 class="inline-flex items-center gap-2 rounded-full border border-line bg-subtle px-4 py-1.5 text-xs font-bold tracking-wide text-txt-primary sm:text-sm">
        <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{t.hireMe.h1Badge}</span>
      </h1>

      <h2 class="mt-5 text-2xl font-extrabold tracking-tight text-txt-primary sm:text-4xl">
        {t.hireMe.heading}
      </h2>

      <p class="mt-4 text-base font-semibold text-txt-primary sm:text-lg">
        {t.hireMe.intro}
      </p>

      <p class="mt-3 text-sm leading-relaxed text-txt-secondary sm:text-base">
        {t.hireMe.subcopy}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          t.hireMe.specialties.map((spec) => (
            <div class="rounded-xl border border-line bg-subtle/40 p-5">
              <h3 class="text-base font-bold text-txt-primary">{spec.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-txt-secondary">{spec.description}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border border-line bg-subtle/50 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-txt-primary sm:text-2xl">
          {t.hireMe.ctaHeading}
        </h2>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={`mailto:${t.hireMe.email}`}
            class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-xl bg-accent px-5 py-3 text-sm font-bold text-accent-contrast shadow-sm transition-all duration-200 ease-studio hover:bg-accent-hover"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6" />
            </svg>
            <span>{t.hireMe.emailLabel}</span>
          </a>

          <button
            type="button"
            id="copy-email-btn"
            data-email={t.hireMe.email}
            data-default-label={t.hireMe.copyButtonLabel}
            data-copied-msg={t.hireMe.copiedAnnouncement}
            aria-label={t.hireMe.copyButtonLabel}
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl border border-line bg-card px-5 py-3 text-sm font-bold text-txt-primary transition-all duration-200 ease-studio hover:border-accent hover:bg-subtle"
          >
            <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
            </svg>
            <span id="copy-email-label">{t.hireMe.copyButtonLabel}</span>
          </button>
        </div>

        <p
          id="copy-email-status"
          role="status"
          aria-live="polite"
          class="mt-3 min-h-[20px] text-xs font-semibold text-accent"
        ></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-email-btn');
      var status = document.getElementById('copy-email-status');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var email = btn.getAttribute('data-email') || 'kisharadilshan007@gmail.com';
        var copiedMsg = btn.getAttribute('data-copied-msg') || 'Copied!';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(function () {
            if (status) status.textContent = copiedMsg;
            setTimeout(function () {
              if (status) status.textContent = '';
            }, 3500);
          });
        }
      });
    })();
  </script>
</BaseLayout>
