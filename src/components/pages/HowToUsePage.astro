---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import {
  TRANSLATIONS,
  getCanonicalUrl,
  getLocalizedPath,
  type LocaleCode,
} from '../../i18n/translations';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale];
const homeUrl = getCanonicalUrl(locale, '');
const pageUrl = getCanonicalUrl(locale, 'how-to-use/');
const viewerHref = getLocalizedPath(locale, '');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.nav.home,
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.howToUse,
      item: pageUrl,
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.howToUse.h1,
  description: t.howToUse.metaDescription,
  inLanguage: locale,
  totalTime: 'PT2M',
  step: t.howToUse.steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.description,
    url: `${pageUrl}#step-${index + 1}`,
  })),
};
---

<BaseLayout
  locale={locale}
  pagePath="how-to-use/"
  title={t.howToUse.title}
  description={t.howToUse.metaDescription}
  schemas={[breadcrumbSchema, howToSchema]}
>
  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs locale={locale} currentLabel={t.nav.howToUse} />

    <h1 class="text-2xl font-extrabold tracking-tight text-txt-primary sm:text-4xl">
      {t.howToUse.h1}
    </h1>
    <p class="mt-4 text-base leading-relaxed text-txt-secondary sm:text-lg">
      {t.howToUse.intro}
    </p>

    <ol class="mt-10 space-y-5">
      {
        t.howToUse.steps.map((step, index) => (
          <li
            id={`step-${index + 1}`}
            class="flex flex-col gap-4 rounded-2xl border border-line bg-card p-6 shadow-sm sm:flex-row sm:items-start"
          >
            <span
              aria-hidden="true"
              class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent font-mono text-base font-bold text-accent-contrast"
            >
              {index + 1}
            </span>
            <div>
              <h2 class="text-lg font-bold text-txt-primary">{step.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-txt-secondary sm:text-base">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Viewport Navigation Quick Reference Table -->
    <div class="mt-12 rounded-2xl border border-line bg-card p-6 shadow-sm">
      <h2 class="text-lg font-bold text-txt-primary sm:text-xl">
        {t.howToUse.controlsHeading}
      </h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-line text-xs font-bold uppercase tracking-wider text-txt-secondary">
              <th class="py-3 pr-4">{t.howToUse.colAction}</th>
              <th class="py-3 px-4">{t.howToUse.colDesktop}</th>
              <th class="py-3 pl-4">{t.howToUse.colTouch}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              t.howToUse.controls.map((row) => (
                <tr>
                  <td class="py-3 pr-4 font-semibold text-txt-primary">{row.action}</td>
                  <td class="py-3 px-4 text-txt-secondary">{row.desktop}</td>
                  <td class="py-3 pl-4 text-txt-secondary">{row.touch}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href={viewerHref}
        class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-xl bg-accent px-6 py-3 text-sm font-bold text-accent-contrast shadow-sm transition-all duration-200 ease-studio hover:bg-accent-hover"
      >
        <span>{t.howToUse.ctaLabel}</span>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
