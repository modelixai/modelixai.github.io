---
import { TRANSLATIONS, getLocalizedPath, type LocaleCode } from '../i18n/translations';

interface Props {
  locale: LocaleCode;
  pagePath: '' | 'how-to-use/' | 'hire-me/';
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale];
const homeHref = getLocalizedPath(locale, '');
const howToHref = getLocalizedPath(locale, 'how-to-use/');
const hireMeHref = getLocalizedPath(locale, 'hire-me/');
---

<footer class="mt-16 border-t border-line bg-card/80">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="text-sm font-bold tracking-tight text-txt-primary">ModelixAI</span>
          <span class="text-xs text-txt-secondary">• {t.footer.builtBy}</span>
        </div>
        <p class="max-w-xl text-xs leading-relaxed text-txt-secondary">
          {t.footer.privacyNote}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-txt-secondary">
        <a href={homeHref} class="transition-colors hover:text-txt-primary">{t.nav.home}</a>
        <a href={howToHref} class="transition-colors hover:text-txt-primary">{t.nav.howToUse}</a>
        <a href={hireMeHref} class="transition-colors hover:text-txt-primary">{t.nav.hireMe}</a>
        <a
          href="https://kisharadilshan.gumroad.com/coffee"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-txt-primary"
        >
          {t.nav.supportDev}
        </a>
        <a
          href="https://github.com/modelixai/modelixai.github.io"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View source code on GitHub"
          class="transition-colors hover:text-txt-primary"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="mt-6 border-t border-line/60 pt-4 text-xs text-txt-secondary">
      <span>© 2026 ModelixAI — Kishara Dilshan. {t.footer.allRights}</span>
    </div>
  </div>
</footer>
